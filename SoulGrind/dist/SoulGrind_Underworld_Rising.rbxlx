<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX21"><Properties><bool name="Archivable">true</bool><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX22"><Properties><bool name="Archivable">true</bool><string name="Name">Lighting</string><token name="Technology">3</token><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX8"><Properties><bool name="Archivable">true</bool><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX7"><Properties><bool name="Archivable">true</bool><string name="Name">SoulGrind</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">-- Replace the zero IDs after creating the products in Creator Hub.
