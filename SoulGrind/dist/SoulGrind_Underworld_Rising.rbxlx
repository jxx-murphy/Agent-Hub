<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX23"><Properties><bool name="Archivable">true</bool><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX24"><Properties><bool name="Archivable">true</bool><string name="Name">Lighting</string><token name="Technology">4</token><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX9"><Properties><bool name="Archivable">true</bool><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX8"><Properties><bool name="Archivable">true</bool><string name="Name">SoulGrind</string></Properties><Item class="ModuleScript" referent="RBX6"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">-- Replace the zero IDs after creating the products in Creator Hub.
return {
	DataStoreName = "SoulGrind_v1",
	StudioPersistence = false,

	DailyGoal = 10,
	DailyReward = 3,
	CheckInSeconds = 600,
	CheckInMinKills = 3,

	-- Shared by the server (authority) and the client (target plate, cooldown sweeps).
	-- One source of truth stops the HUD from promising a reach the server will refuse.
	AttackRange = 34,
	PulseRange = 22,
	Cooldowns = { Attack = 0.34, Finisher = 0.52, Pulse = 8, Dash = 3 },

	-- Enemies hold a post. They wake when you come close, chase while you stay inside
	-- the leash, then walk home and heal. Nothing follows you across the map forever.
	Aggro = {
		Engage = 28,
		Leash = 62,
		ReturnSpeed = 1.4,
		RegenPerSecond = 9,
		CalmSeconds = 4,
	},

	-- Crimson and gold. Neon is reserved for flame cores, lava seams and the boss
	-- telegraph; every other surface is a real material lit by real lights.
	-- Dark anime base: charcoal, indigo-cooled slate and obsidian. Emissive accents stay
	-- warm (crimson, amber, ember) so fire reads against a cold world instead of joining it.
	Palette = {
		Obsidian = Color3.fromRGB(26, 24, 34),
		Charcoal = Color3.fromRGB(40, 39, 48),
		Indigo = Color3.fromRGB(44, 42, 68),
		Slate = Color3.fromRGB(64, 63, 80),
		SlateLight = Color3.fromRGB(86, 85, 104),
		Bedrock = Color3.fromRGB(22, 21, 30),
		Rock = Color3.fromRGB(52, 51, 66),
		RockLight = Color3.fromRGB(74, 73, 92),
		Floor = Color3.fromRGB(70, 68, 86),
		FloorAlt = Color3.fromRGB(88, 86, 106),
		Stone = Color3.fromRGB(104, 102, 124),
		StoneDark = Color3.fromRGB(58, 57, 74),
		Bone = Color3.fromRGB(206, 202, 214),
		Plaster = Color3.fromRGB(112, 110, 130),
		Timber = Color3.fromRGB(62, 52, 60),
		Roof = Color3.fromRGB(46, 44, 62),
		Cobble = Color3.fromRGB(78, 77, 94),
		Iron = Color3.fromRGB(38, 37, 48),
		Gold = Color3.fromRGB(201, 162, 74),
		GoldLight = Color3.fromRGB(232, 200, 120),
		GoldPale = Color3.fromRGB(255, 233, 168),
		Crimson = Color3.fromRGB(140, 35, 32),
		CrimsonMid = Color3.fromRGB(184, 54, 47),
		CrimsonLit = Color3.fromRGB(217, 82, 74),
		CrimsonDeep = Color3.fromRGB(96, 30, 30),
		Ember = Color3.fromRGB(224, 138, 60),
		Amber = Color3.fromRGB(255, 176, 96),
	},

	-- Progression spends souls on the moves themselves, not only on a damage number.
	-- Order is the display order in the Journal.
	Abilities = {
		{
			Key = "Strike",
			Name = "Soul Strike",
			Detail = "+14% strike damage per rank. Rank 3 makes the finisher knock back everything nearby.",
			Max = 5,
			BaseCost = 45,
			Growth = 1.6,
			RequiresLevel = 1,
		},
		{
			Key = "Pulse",
			Name = "Soul Pulse",
			Detail = "+4 studs radius and +12% damage per rank.",
			Max = 5,
			BaseCost = 70,
			Growth = 1.65,
			RequiresLevel = 3,
		},
		{
			Key = "Step",
			Name = "Soul Step",
			Detail = "-0.4s cooldown and a longer phase window per rank.",
			Max = 4,
			BaseCost = 55,
			Growth = 1.7,
			RequiresLevel = 1,
		},
	},

	Products = {
		FlarePack = {
			Id = 0,
			Amount = 5,
			Item = "Flares",
			Label = "5 Soul Flares",
			Description = "Five cosmetic bursts. Daily play also earns free flares.",
		},
	},

	Passes = {
		Aura = {
			Id = 0,
			Label = "Eternal Violet Aura",
			Description = "A permanent cosmetic aura with no combat bonus.",
		},
	},

	-- Half-extents of the walkable arena. The old 146x106 pad felt like a waiting room.
	ArenaHalf = Vector3.new(140, 0, 110),

	Zones = {
		[1] = {
			Name = "Ashenfall Village",
			Origin = Vector3.new(0, 0, 0),
			Accent = Color3.fromRGB(184, 54, 47),
			AccentLight = Color3.fromRGB(217, 82, 74),
			Floor = Color3.fromRGB(66, 64, 82),
			FloorAlt = Color3.fromRGB(84, 82, 102),
			Stone = Color3.fromRGB(104, 102, 124),
			EnemyHealth = 36,
			EnemyDamage = 7,
			SoulReward = 10,
		},
		[2] = {
			Name = "Blackspire Keep",
			Origin = Vector3.new(520, 0, 0),
			Accent = Color3.fromRGB(201, 162, 74),
			AccentLight = Color3.fromRGB(232, 200, 120),
			Floor = Color3.fromRGB(74, 70, 88),
			FloorAlt = Color3.fromRGB(92, 88, 108),
			Stone = Color3.fromRGB(112, 108, 130),
			EnemyHealth = 95,
			EnemyDamage = 12,
			SoulReward = 28,
		},
	},
}
</ProtectedString><string name="Name">Config</string></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">-- The game already had a progression; it just never told anyone about it. This turns
-- that progression into a named, ordered, checkable list that the server grants from and
-- the client, the world signs and the objective banner all read from.
--
-- Progress is derived from the profile, never stored separately, so a quest can never
-- disagree with the save. Only the "already paid out" set is stored.

local Quests = {}

Quests.list = {
	{
		Id = "FirstSoul",
		Title = "First Blood",
		Detail = "Strike down a single Cinder Shade.",
		Hint = "Walk up to a shade and press F, or click it.",
		Target = 1,
		Reward = 15,
		Progress = function(profile) return profile.Kills end,
	},
	{
		Id = "CullTheHollow",
		Title = "Cull the Hollow",
		Detail = "Defeat 10 of the hollow things in Cinder Hollow.",
		Hint = "Shades are weakest, Reavers hit hardest, Wisps are fastest.",
		Target = 10,
		Reward = 30,
		Progress = function(profile) return profile.Kills end,
	},
	{
		Id = "SoulPower",
		Title = "Kindle the Soul",
		Detail = "Reach Soul Level 3 to unlock Soul Pulse.",
		Hint = "Spend souls on UPGRADE in the Journal.",
		Target = 3,
		Reward = 40,
		Progress = function(profile) return profile.Level end,
	},
	{
		Id = "SharpenTheBlade",
		Title = "Sharpen the Blade",
		Detail = "Buy your first move upgrade.",
		Hint = "The MOVES tab in the Journal ranks up Strike, Pulse and Step.",
		Target = 1,
		Reward = 35,
		Progress = function(profile)
			local total = 0
			for _, rank in profile.Upgrades do total += rank end
			return total
		end,
	},
	{
		Id = "AshGate",
		Title = "Open the Ash Gate",
		Detail = "Gather 150 souls and break the seal on the Ash Gate.",
		Hint = "The gate is the tall arch at the far end of the hollow.",
		Target = 2,
		Reward = 60,
		Progress = function(profile) return profile.MaxZone end,
	},
	{
		Id = "IntoTheDeep",
		Title = "Into the Reliquary",
		Detail = "Defeat 5 of the guardians beyond the gate.",
		Hint = "They hit far harder than anything in the hollow. Soul Step through them.",
		Target = 5,
		Reward = 90,
		Progress = function(profile) return profile.DeepKills end,
	},
	{
		Id = "WardenSigil",
		Title = "Bind the Gilded Warden",
		Detail = "Defeat the Warden at the heart of the Reliquary.",
		Hint = "It telegraphs a slam. Soul Step (E) passes straight through it.",
		Target = 1,
		Reward = 150,
		Progress = function(profile) return profile.Bosses end,
	},
	{
		Id = "Reborn",
		Title = "Rebirth",
		Detail = "Gather 500 souls and be reborn for a permanent +10% damage.",
		Hint = "Rebirth keeps your zones, sigils and move ranks.",
		Target = 1,
		Reward = 200,
		Progress = function(profile) return profile.Rebirths end,
	},
}

Quests.count = #Quests.list

function Quests.byId(id)
	for _, quest in Quests.list do
		if quest.Id == id then return quest end
	end
	return nil
end

-- One pass produces everything any surface needs: the per-quest rows for the guide,
-- the current objective for the banner and the world signs, and the completion rate.
function Quests.snapshot(profile)
	local rows = {}
	local completed = 0
	local active

	for index, quest in Quests.list do
		local raw = quest.Progress(profile)
		local value = math.clamp(type(raw) == "number" and raw or 0, 0, quest.Target)
		local done = value &gt;= quest.Target
		if done then completed += 1 end

		local row = {
			Id = quest.Id,
			Title = quest.Title,
			Detail = quest.Detail,
			Hint = quest.Hint,
			Value = value,
			Target = quest.Target,
			Reward = quest.Reward,
			Done = done,
			Order = index,
		}
		rows[index] = row
		if not done and not active then active = row end
	end

	return {
		Rows = rows,
		Active = active,
		Completed = completed,
		Total = Quests.count,
		-- Task completion rate, as a percentage, for the HUD and the guide header.
		Rate = math.floor(completed / Quests.count * 100 + 0.5),
	}
end

return Quests
</ProtectedString><string name="Name">Quests</string></Properties></Item><Item class="RemoteEvent" referent="RBX1"><Properties><bool name="Archivable">true</bool><string name="Name">Action</string></Properties></Item><Item class="RemoteEvent" referent="RBX2"><Properties><bool name="Archivable">true</bool><string name="Name">State</string></Properties></Item><Item class="RemoteEvent" referent="RBX3"><Properties><bool name="Archivable">true</bool><string name="Name">Notice</string></Properties></Item><Item class="RemoteEvent" referent="RBX4"><Properties><bool name="Archivable">true</bool><string name="Name">Offer</string></Properties></Item><Item class="RemoteEvent" referent="RBX5"><Properties><bool name="Archivable">true</bool><string name="Name">FX</string></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX16"><Properties><bool name="Archivable">true</bool><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX10"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">-- Everything the player looks at.
--
-- Art direction: dark stylised anime. Cold charcoal/indigo world, warm fire accents,
-- heavy contrast, soft glow. Zone 1 is a fallen walled town, zone 2 the keep behind it.
--
-- On geometry: there is no Blender step here, so nothing is a .fbx MeshPart. Curvature
-- comes from Roblox's own smooth primitives instead - WedgePart and CornerWedgePart for
-- every roof and spire, SpecialMesh cylinders for towers and columns, spheres for caps.
-- Faceted low-poly is the target, not bevelled organic; a real mesh pipeline would need
-- Blender plus an asset upload.
--
-- Rules:
--   1. Structural surfaces are SmoothPlastic. No Concrete, Slate or Brick noise.
--   2. Glow is Glass/Neon at 0.6-0.85 transparency, never an opaque bright slab.
--   3. Small detail never casts a shadow; jagged shadow maps are what read as cheap.
--   4. You must not see the whole map from the gate.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("SoulGrind").Config)

local World = {}
local palette = Config.Palette
local HALF = Config.ArenaHalf
local FLOOR_Y = 1.5

local signBoards = {}

local function mix(a, b, t)
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

local function shape(parent, className, name, size, cframe, color, material)
	local part = Instance.new(className)
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function makePart(parent, name, size, cframe, color, material)
	return shape(parent, "Part", name, size, cframe, color, material)
end

-- Detail: no collision, no query, and crucially no shadow.
local function decor(parent, name, size, cframe, color, material)
	local part = makePart(parent, name, size, cframe, color, material)
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function wedge(parent, name, size, cframe, color, material, solid)
	local part = shape(parent, "WedgePart", name, size, cframe, color, material)
	if not solid then
		part.CanCollide = false
		part.CanQuery = false
		part.CastShadow = false
	end
	return part
end

local function cornerWedge(parent, name, size, cframe, color, material)
	local part = shape(parent, "CornerWedgePart", name, size, cframe, color, material)
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	return part
end

-- A real cylinder, not a box pretending. SpecialMesh keeps the axis upright.
local function cylinder(parent, name, diameter, height, cframe, color, material, solid)
	local part = makePart(parent, name, Vector3.new(diameter, height, diameter), cframe, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Scale = Vector3.new(1, 1, 1)
	mesh.Parent = part
	if not solid then
		part.CanCollide = false
		part.CanQuery = false
		part.CastShadow = false
	end
	return part
end

local function sphere(parent, name, diameter, cframe, color, material)
	local part = makePart(parent, name, Vector3.new(diameter, diameter, diameter), cframe, color, material)
	part.Shape = Enum.PartType.Ball
	part.CanCollide = false
	part.CanQuery = false
	part.CastShadow = false
	return part
end

-- Glow is always translucent. An opaque Neon slab is the whiteout mistake.
local function glow(parent, name, size, cframe, color, transparency, material)
	local part = decor(parent, name, size, cframe, color, material or Enum.Material.Neon)
	part.Transparency = transparency or 0.72
	return part
end

World.makePart = makePart

local function addLabel(part, text, color, height, maxDistance)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "WorldLabel"
	billboard.Size = UDim2.fromOffset(240, 44)
	billboard.StudsOffset = Vector3.new(0, height or 5, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = maxDistance or 90
	billboard.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.05
	label.TextStrokeColor3 = Color3.fromRGB(8, 6, 12)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Parent = billboard
	return label
end

-- Lighting ------------------------------------------------------------------
-- Roughly 70% of the look. Cold desaturated base, punchy contrast, warm glow.
function World.applyLighting()
	Lighting.ClockTime = 0.15
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 1.6
	Lighting.ExposureCompensation = 0.05
	Lighting.Ambient = Color3.fromRGB(52, 50, 66)
	Lighting.OutdoorAmbient = Color3.fromRGB(62, 60, 80)
	Lighting.FogColor = Color3.fromRGB(20, 18, 30)
	Lighting.FogStart = 70
	Lighting.FogEnd = 300
	Lighting.EnvironmentDiffuseScale = 0.25
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.34
	atmosphere.Haze = 2.4
	atmosphere.Glare = 0.08
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(116, 110, 148)
	atmosphere.Decay = Color3.fromRGB(32, 28, 46)
	atmosphere.Parent = Lighting

	local function effect(className, name, properties)
		local instance = Lighting:FindFirstChild(name) or Instance.new(className)
		instance.Name = name
		for property, value in properties do instance[property] = value end
		instance.Parent = Lighting
	end

	-- Low threshold so soul drops, runes and portals bloom the way energy should.
	effect("BloomEffect", "SoulBloom", { Intensity = 0.55, Size = 30, Threshold = 0.9 })
	effect("ColorCorrectionEffect", "UnderworldGrade", {
		Contrast = 0.22, Saturation = -0.2, Brightness = 0, TintColor = Color3.fromRGB(27, 21, 40),
	})
	-- Softens the far silhouette without touching the combat zone: the focus radius is
	-- wider than any fight, so nothing the player is swinging at is ever blurred.
	effect("DepthOfFieldEffect", "SoulDepth", {
		FarIntensity = 0.32, FocusDistance = 60, InFocusRadius = 120, NearIntensity = 0,
	})
end

-- Ambience ------------------------------------------------------------------

local function dust(parent, position, color, rate, size)
	local anchor = decor(parent, "DustAnchor", Vector3.new(1, 1, 1), CFrame.new(position), color, Enum.Material.SmoothPlastic)
	anchor.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color, mix(color, Color3.new(1, 1, 1), 0.6))
	emitter.LightEmission = 0.75
	emitter.Lifetime = NumberRange.new(4, 9)
	emitter.Rate = rate or 8
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-24, 24)
	emitter.Size = NumberSequence.new(size or 0.9)
	emitter.Speed = NumberRange.new(0.6, 2.4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Transparency = NumberSequence.new(0.35)
	emitter.Parent = anchor
	return anchor
end

-- Ground sigil. Translucent neon ring, never an opaque disc.
local function runeCircle(parent, position, diameter, color)
	local ring = cylinder(parent, "RuneCircle", diameter, 0.25, CFrame.new(position + Vector3.new(0, 0.12, 0)), color, Enum.Material.Neon)
	ring.Transparency = 0.78
	local inner = cylinder(parent, "RuneInner", diameter * 0.6, 0.25, CFrame.new(position + Vector3.new(0, 0.16, 0)), color, Enum.Material.Neon)
	inner.Transparency = 0.86
	for index = 0, 5 do
		local angle = index * math.pi / 3
		local mark = glow(parent, "RuneMark", Vector3.new(1.1, 0.2, diameter * 0.34),
			CFrame.new(position + Vector3.new(math.cos(angle) * diameter * 0.34, 0.2, math.sin(angle) * diameter * 0.34)) * CFrame.Angles(0, -angle, 0),
			color, 0.7)
		mark.Material = Enum.Material.Neon
	end
end

-- Floating ruin fragments. No shadows, deliberately off-axis.
local function shards(parent, position, count, color)
	for index = 1, count or 6 do
		local angle = index * 1.9
		local radius = 6 + (index % 3) * 5
		local size = 1.6 + (index % 4) * 0.9
		local fragment = decor(parent, "SoulShard", Vector3.new(size, size * 1.6, size * 0.7),
			CFrame.new(position + Vector3.new(math.cos(angle) * radius, 6 + (index % 5) * 4, math.sin(angle) * radius))
				* CFrame.Angles(index * 0.7, angle, index * 0.4),
			color, Enum.Material.Glass)
		fragment.Transparency = 0.55
		fragment.Reflectance = 0.15
	end
end

-- Pieces --------------------------------------------------------------------

local function pitchedRoof(parent, cf, width, depth, height, color)
	-- Two wedges back to back. This one change is most of the "not blocky".
	for side = -1, 1, 2 do
		wedge(parent, "Roof", Vector3.new(depth, height, width / 2),
			cf * CFrame.new(side * width / 4, height / 2, 0) * CFrame.Angles(0, side &gt; 0 and math.rad(90) or math.rad(-90), 0),
			color, Enum.Material.SmoothPlastic)
	end
	decor(parent, "RoofRidge", Vector3.new(1.2, 0.8, depth + 1), cf * CFrame.new(0, height, 0), mix(color, palette.Bone, 0.25))
end

local function pyramidSpire(parent, position, width, height, color)
	-- Four corner wedges make a clean faceted spire with no stair-stepping.
	for index = 0, 3 do
		local angle = index * math.pi / 2
		cornerWedge(parent, "SpireFace", Vector3.new(width / 2, height, width / 2),
			CFrame.new(position + Vector3.new(math.cos(angle) * width / 4, height / 2, math.sin(angle) * width / 4)) * CFrame.Angles(0, -angle, 0),
			color, Enum.Material.SmoothPlastic)
	end
	sphere(parent, "SpireFinial", width * 0.22, CFrame.new(position + Vector3.new(0, height + 1, 0)), palette.Gold, Enum.Material.SmoothPlastic)
end

local function roundTower(parent, position, diameter, height, accent)
	cylinder(parent, "TowerBase", diameter + 4, 3, CFrame.new(position + Vector3.new(0, 1.5, 0)), palette.StoneDark, Enum.Material.SmoothPlastic, true)
	-- Three stacked segments with a subtle vertical ramp instead of one flat colour.
	for tier = 0, 2 do
		local segment = height / 3
		cylinder(parent, "TowerShaft", diameter, segment,
			CFrame.new(position + Vector3.new(0, 3 + segment / 2 + tier * segment, 0)),
			mix(palette.Rock, palette.SlateLight, tier * 0.22), Enum.Material.SmoothPlastic, true)
	end
	cylinder(parent, "TowerBand", diameter + 2, 1.4, CFrame.new(position + Vector3.new(0, 3 + height * 0.62, 0)), palette.StoneDark)
	cylinder(parent, "TowerCrown", diameter + 3.4, 2.2, CFrame.new(position + Vector3.new(0, height + 4, 0)), palette.StoneDark)

	for index = 0, 7 do
		local angle = index * math.pi / 4
		decor(parent, "Merlon", Vector3.new(2.6, 3, 2.6),
			CFrame.new(position + Vector3.new(math.cos(angle) * (diameter / 2 + 1), height + 6.5, math.sin(angle) * (diameter / 2 + 1))) * CFrame.Angles(0, -angle, 0),
			palette.Rock)
	end
	pyramidSpire(parent, position + Vector3.new(0, height + 7.5, 0), diameter + 3, diameter * 1.5, palette.Roof)

	-- Arrow slits glow faintly from within.
	for index = 0, 3 do
		local angle = index * math.pi / 2
		glow(parent, "SlitGlow", Vector3.new(0.9, 4.5, 0.6),
			CFrame.new(position + Vector3.new(math.cos(angle) * (diameter / 2), height * 0.55, math.sin(angle) * (diameter / 2))) * CFrame.Angles(0, -angle, 0),
			accent or palette.Amber, 0.62)
	end
end

local function column(parent, position, diameter, height)
	cylinder(parent, "ColumnBase", diameter + 1.8, 1.6, CFrame.new(position + Vector3.new(0, 0.8, 0)), palette.StoneDark, Enum.Material.SmoothPlastic, true)
	cylinder(parent, "ColumnShaft", diameter, height, CFrame.new(position + Vector3.new(0, height / 2 + 1.6, 0)), palette.Stone, Enum.Material.SmoothPlastic, true)
	cylinder(parent, "ColumnCap", diameter + 2, 1.8, CFrame.new(position + Vector3.new(0, height + 2.4, 0)), palette.StoneDark)
	sphere(parent, "ColumnFinial", diameter * 0.7, CFrame.new(position + Vector3.new(0, height + 4, 0)), palette.SlateLight)
end

local function lamp(parent, position, height)
	height = height or 9
	cylinder(parent, "LampPost", 0.7, height, CFrame.new(position + Vector3.new(0, height / 2, 0)), palette.Iron, Enum.Material.SmoothPlastic, true)
	decor(parent, "LampArm", Vector3.new(2.2, 0.35, 0.35), CFrame.new(position + Vector3.new(0.9, height, 0)), palette.Iron)
	local cage = sphere(parent, "LampCage", 2.1, CFrame.new(position + Vector3.new(1.7, height - 0.9, 0)), palette.Amber, Enum.Material.Glass)
	cage.Transparency = 0.68
	cage.Reflectance = 0.1
	local flame = sphere(parent, "LampFlame", 1.1, cage.CFrame, palette.Amber, Enum.Material.Neon)
	flame.Transparency = 0.25

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 176, 104)
	light.Brightness = 1.9
	light.Range = 34
	light.Shadows = false
	light.Parent = flame
end

local function brazier(parent, position, accent)
	cylinder(parent, "BrazierColumn", 1.8, 4.5, CFrame.new(position + Vector3.new(0, 2.25, 0)), palette.StoneDark, Enum.Material.SmoothPlastic, true)
	cylinder(parent, "BrazierBowl", 3.6, 1.4, CFrame.new(position + Vector3.new(0, 5.1, 0)), palette.Iron, Enum.Material.SmoothPlastic, true)
	local flame = sphere(parent, "BrazierFlame", 2.4, CFrame.new(position + Vector3.new(0, 6.4, 0)), accent or palette.Ember, Enum.Material.Neon)
	flame.Transparency = 0.3

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 166, 92)
	light.Brightness = 2.3
	light.Range = 42
	light.Shadows = true
	light.Parent = flame

	local fire = Instance.new("ParticleEmitter")
	fire.Texture = "rbxasset://textures/particles/fire_main.dds"
	fire.Color = ColorSequence.new(palette.GoldPale, accent or palette.CrimsonMid)
	fire.LightEmission = 1
	fire.Lifetime = NumberRange.new(0.45, 0.85)
	fire.Rate = 26
	fire.Size = NumberSequence.new(3)
	fire.Speed = NumberRange.new(2, 4)
	fire.SpreadAngle = Vector2.new(14, 14)
	fire.Parent = flame
end

-- Wall with a vertical colour ramp, a smooth coping and wedge-capped merlons.
local function wallRun(parent, from, to, height, thickness)
	height = height or 22
	thickness = thickness or 6
	local delta = to - from
	local length = delta.Magnitude
	if length &lt; 1 then return end
	local mid = from + delta * 0.5
	local angle = math.atan2(delta.X, delta.Z)
	local base = CFrame.new(mid) * CFrame.Angles(0, angle, 0)

	for tier = 0, 2 do
		local segment = height / 3
		local body = shape(parent, "Part", "CurtainWall", Vector3.new(thickness, segment, length),
			base * CFrame.new(0, segment / 2 + tier * segment, 0),
			mix(palette.Obsidian, palette.Slate, 0.25 + tier * 0.3), Enum.Material.SmoothPlastic)
		body.CastShadow = tier &gt; 0
	end
	decor(parent, "WallCoping", Vector3.new(thickness + 1.8, 1, length), base * CFrame.new(0, height, 0), palette.SlateLight)

	local merlons = math.max(2, math.floor(length / 7))
	for index = 0, merlons do
		local along = -length / 2 + index * (length / merlons)
		local merlon = decor(parent, "Merlon", Vector3.new(thickness, 3, 2.8), base * CFrame.new(0, height + 2, along), palette.Slate)
		-- Wedge caps stop the battlements reading as a row of cubes.
		for side = -1, 1, 2 do
			wedge(parent, "MerlonCap", Vector3.new(2.8, 1.4, thickness / 2),
				base * CFrame.new(side * thickness / 4, height + 4.2, along) * CFrame.Angles(0, side &gt; 0 and 0 or math.rad(180), 0),
				palette.SlateLight)
		end
		merlon.Name = "Merlon"
	end
end

local function house(parent, cf, width, depth, height, ruined)
	width = width or 18
	depth = depth or 16
	height = height or 14

	makePart(parent, "HouseBase", Vector3.new(width, 4, depth), cf * CFrame.new(0, 2, 0), palette.StoneDark)
	makePart(parent, "HouseWall", Vector3.new(width - 1, height, depth - 1), cf * CFrame.new(0, 4 + height / 2, 0), palette.Plaster)
	-- Upper storey slightly lighter: a hand-painted ramp rather than one flat tone.
	decor(parent, "HouseUpper", Vector3.new(width - 0.6, height * 0.4, depth - 0.6), cf * CFrame.new(0, 4 + height * 0.8, 0), mix(palette.Plaster, palette.SlateLight, 0.35))

	for index = -1, 1 do
		decor(parent, "Timber", Vector3.new(0.7, height, 0.5), cf * CFrame.new(index * (width / 3), 4 + height / 2, depth / 2 - 0.25), palette.Timber)
		decor(parent, "Timber", Vector3.new(0.7, height, 0.5), cf * CFrame.new(index * (width / 3), 4 + height / 2, -depth / 2 + 0.25), palette.Timber)
	end

	decor(parent, "Door", Vector3.new(4, 7, 0.4), cf * CFrame.new(0, 7.5, depth / 2 - 0.2), palette.Timber)
	wedge(parent, "DoorArch", Vector3.new(0.5, 2.2, 5), cf * CFrame.new(0, 11.2, depth / 2 - 0.2) * CFrame.Angles(0, math.rad(90), 0), palette.StoneDark)
	for side = -1, 1, 2 do
		-- Lit windows: warm glass, never a bright opaque square.
		local pane = decor(parent, "Window", Vector3.new(3.2, 3.2, 0.4), cf * CFrame.new(side * (width / 4), 4 + height * 0.68, depth / 2 - 0.2), palette.Amber, Enum.Material.Glass)
		pane.Transparency = 0.66
		decor(parent, "Shutter", Vector3.new(1.5, 3.4, 0.3), cf * CFrame.new(side * (width / 4) + 2.2, 4 + height * 0.68, depth / 2 - 0.35), palette.Timber)
	end

	pitchedRoof(parent, cf * CFrame.new(0, 4 + height, 0), width + 2.5, depth + 2.5, height * 0.62, palette.Roof)
	cylinder(parent, "Chimney", 2.6, 12, cf * CFrame.new(width / 2 - 3, 4 + height + 6, -depth / 4), palette.StoneDark)

	if ruined then
		for index = 1, 3 do
			decor(parent, "Rubble", Vector3.new(4 + index, 3 + index * 0.6, 4 + index),
				cf * CFrame.new(width / 2 - 1 + index, 2, -depth / 2 + index * 1.4) * CFrame.Angles(index * 0.3, index * 0.6, index * 0.2),
				mix(palette.Rock, palette.Charcoal, 0.3))
		end
	end
end

local function marketStall(parent, cf)
	makePart(parent, "StallCounter", Vector3.new(10, 3.5, 4), cf * CFrame.new(0, 1.75, 0), palette.Timber)
	for side = -1, 1, 2 do
		cylinder(parent, "StallPost", 0.7, 9, cf * CFrame.new(side * 4.6, 4.5, 0), palette.Timber, Enum.Material.SmoothPlastic, true)
	end
	for side = -1, 1, 2 do
		wedge(parent, "StallAwning", Vector3.new(7, 2.4, 6), cf * CFrame.new(side * 3, 9.6, 1.4) * CFrame.Angles(0, side &gt; 0 and math.rad(90) or math.rad(-90), 0), palette.CrimsonMid)
	end
end

local function props(parent, position, count)
	for index = 1, count or 3 do
		local angle = index * 2.3
		local offset = Vector3.new(math.cos(angle) * 3.2, 0, math.sin(angle) * 3.2)
		if index % 2 == 0 then
			cylinder(parent, "Barrel", 3, 4, CFrame.new(position + offset + Vector3.new(0, 2, 0)), palette.Timber, Enum.Material.SmoothPlastic, true)
			cylinder(parent, "BarrelBand", 3.2, 0.4, CFrame.new(position + offset + Vector3.new(0, 2.6, 0)), palette.Iron)
		else
			makePart(parent, "Crate", Vector3.new(3.4, 3.4, 3.4), CFrame.new(position + offset + Vector3.new(0, 1.7, 0)) * CFrame.Angles(0, index * 0.4, 0), palette.Timber)
		end
	end
end

local function well(parent, position)
	cylinder(parent, "WellRing", 9, 4, CFrame.new(position + Vector3.new(0, 2, 0)), palette.Stone, Enum.Material.SmoothPlastic, true)
	local water = cylinder(parent, "WellWater", 7, 0.4, CFrame.new(position + Vector3.new(0, 3.7, 0)), palette.Indigo, Enum.Material.Glass)
	water.Transparency = 0.5
	water.Reflectance = 0.3
	for side = -1, 1, 2 do
		cylinder(parent, "WellPost", 0.8, 9, CFrame.new(position + Vector3.new(side * 4, 8, 0)), palette.Timber, Enum.Material.SmoothPlastic, true)
	end
	decor(parent, "WellBeam", Vector3.new(10, 0.8, 0.8), CFrame.new(position + Vector3.new(0, 12.4, 0)), palette.Timber)
	pitchedRoof(parent, CFrame.new(position + Vector3.new(0, 12.8, 0)), 11, 8, 4, palette.Roof)
end

local function banner(parent, cf, height)
	decor(parent, "Banner", Vector3.new(5, height or 16, 0.25), cf, palette.CrimsonMid, Enum.Material.SmoothPlastic)
	wedge(parent, "BannerTail", Vector3.new(0.3, 2.4, 5), cf * CFrame.new(0, -(height or 16) / 2 - 1.2, 0) * CFrame.Angles(0, math.rad(90), 0), palette.CrimsonMid)
	decor(parent, "BannerRod", Vector3.new(6, 0.4, 0.4), cf * CFrame.new(0, (height or 16) / 2 + 0.4, 0), palette.Iron)
end

local function cobbleRoad(parent, from, to, width)
	local delta = to - from
	local length = delta.Magnitude
	if length &lt; 1 then return end
	local mid = from + delta * 0.5
	local angle = math.atan2(delta.X, delta.Z)
	local cf = CFrame.new(mid + Vector3.new(0, FLOOR_Y, 0)) * CFrame.Angles(0, angle, 0)
	decor(parent, "Cobble", Vector3.new(width or 22, 0.5, length), cf, palette.Cobble)
	for side = -1, 1, 2 do
		decor(parent, "Kerb", Vector3.new(1.4, 0.9, length), cf * CFrame.new(side * ((width or 22) / 2), 0.2, 0), palette.StoneDark)
	end
end

local function signPost(parent, cframe, heading, body)
	cylinder(parent, "SignPost", 1.4, 10, cframe * CFrame.new(0, 5, 0), palette.Timber, Enum.Material.SmoothPlastic, true)
	local board = makePart(parent, "SignBoard", Vector3.new(20, 11, 1), cframe * CFrame.new(0, 13, 0), palette.Timber)
	decor(parent, "SignFrame", Vector3.new(21.4, 12.4, 0.6), cframe * CFrame.new(0, 13, -0.3), palette.Iron)

	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Name = "SignFace"
		surface.Face = face
		surface.CanvasSize = Vector2.new(640, 352)
		-- Zero light influence: on a night map a lit SurfaceGui is an unreadable one.
		surface.LightInfluence = 0
		surface.MaxDistance = 260
		surface.Parent = board

		local backing = Instance.new("Frame")
		backing.Size = UDim2.fromScale(1, 1)
		backing.BackgroundColor3 = Color3.fromRGB(20, 16, 26)
		backing.BorderSizePixel = 0
		backing.Parent = surface

		local edge = Instance.new("UIStroke")
		edge.Color = palette.Gold
		edge.Thickness = 5
		edge.Parent = backing

		local title = Instance.new("TextLabel")
		title.Name = "Heading"
		title.Size = UDim2.new(1, -40, 0, 84)
		title.Position = UDim2.fromOffset(20, 18)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBlack
		title.TextColor3 = palette.GoldPale
		title.TextScaled = true
		title.Text = heading
		title.Parent = backing

		local rule = Instance.new("Frame")
		rule.Size = UDim2.new(1, -40, 0, 4)
		rule.Position = UDim2.fromOffset(20, 108)
		rule.BackgroundColor3 = palette.Gold
		rule.BorderSizePixel = 0
		rule.Parent = backing

		local detail = Instance.new("TextLabel")
		detail.Name = "Body"
		detail.Size = UDim2.new(1, -40, 1, -136)
		detail.Position = UDim2.fromOffset(20, 124)
		detail.BackgroundTransparency = 1
		detail.Font = Enum.Font.GothamMedium
		detail.TextColor3 = Color3.fromRGB(238, 232, 244)
		detail.TextSize = 34
		detail.TextWrapped = true
		detail.TextYAlignment = Enum.TextYAlignment.Top
		detail.Text = body
		detail.Parent = backing

		table.insert(signBoards, { Heading = title, Body = detail, Board = board })
	end

	local lantern = sphere(parent, "SignLantern", 1.8, cframe * CFrame.new(0, 19.6, 0), palette.Amber, Enum.Material.Neon)
	lantern.Transparency = 0.3
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Brightness = 1.6
	light.Range = 26
	light.Parent = lantern
end

function World.setObjective(heading, body)
	for _, entry in signBoards do
		entry.Heading.Text = heading
		entry.Body.Text = body
	end
end

-- Backdrop: faceted monoliths, softened by fog and depth of field.
local function buildBackdrop(parent, center)
	local folder = Instance.new("Folder")
	folder.Name = "Backdrop"
	folder.Parent = parent
	for index = 1, 20 do
		local angle = index * math.pi * 2 / 20
		local radius = 900 + (index % 3) * 220
		local height = 420 + (index % 5) * 190
		local position = center + Vector3.new(math.cos(angle) * radius, height / 2 - 140, math.sin(angle) * radius)
		local ridge = decor(folder, "FarRidge", Vector3.new(300, height, 300),
			CFrame.new(position) * CFrame.Angles(0, angle, math.rad((index % 3) * 4)),
			mix(palette.Bedrock, palette.Indigo, (index % 4) * 0.15))
		ridge.CastShadow = false
		pyramidSpire(folder, position + Vector3.new(0, height / 2, 0), 300, 220, mix(palette.Obsidian, palette.Indigo, 0.4))
	end
end

-- Zone 1: the fallen town ------------------------------------------------------

local function buildVillage(zone, world)
	local folder = Instance.new("Folder")
	folder.Name = "AshenfallVillage"
	folder.Parent = world
	local origin = zone.Origin

	makePart(folder, "Bedrock", Vector3.new(HALF.X * 2 + 60, 14, HALF.Z * 2 + 60), CFrame.new(origin - Vector3.new(0, 7, 0)), palette.Bedrock)
	makePart(folder, "ArenaFloor", Vector3.new(HALF.X * 2, 3, HALF.Z * 2), CFrame.new(origin), zone.Floor)

	cobbleRoad(folder, origin + Vector3.new(0, 0, HALF.Z - 24), origin + Vector3.new(0, 0, -HALF.Z + 40), 24)
	cobbleRoad(folder, origin + Vector3.new(-HALF.X + 40, 0, 6), origin + Vector3.new(HALF.X - 40, 0, 6), 18)

	local cx, cz = HALF.X - 6, HALF.Z - 6
	local corners = {
		origin + Vector3.new(-cx, FLOOR_Y, -cz), origin + Vector3.new(cx, FLOOR_Y, -cz),
		origin + Vector3.new(cx, FLOOR_Y, cz), origin + Vector3.new(-cx, FLOOR_Y, cz),
	}
	for index = 1, 4 do
		local from, to = corners[index], corners[index % 4 + 1]
		if index == 3 then
			wallRun(folder, from, origin + Vector3.new(22, FLOOR_Y, cz), 24, 7)
			wallRun(folder, origin + Vector3.new(-22, FLOOR_Y, cz), to, 24, 7)
		else
			wallRun(folder, from, to, 24, 7)
		end
		roundTower(folder, from, 16, 34, palette.Amber)
	end
	roundTower(folder, origin + Vector3.new(-cx, FLOOR_Y, 0), 14, 30, palette.Amber)
	roundTower(folder, origin + Vector3.new(cx, FLOOR_Y, 0), 14, 30, palette.Amber)

	-- Gatehouse.
	local gatePos = origin + Vector3.new(0, FLOOR_Y, cz)
	for side = -1, 1, 2 do
		roundTower(folder, gatePos + Vector3.new(side * 22, 0, 0), 16, 36, palette.CrimsonLit)
		banner(folder, CFrame.new(gatePos + Vector3.new(side * 22, 26, -9.2)), 18)
	end
	makePart(folder, "GateArch", Vector3.new(44, 10, 12), CFrame.new(gatePos + Vector3.new(0, 30, 0)), palette.Rock)
	for side = -1, 1, 2 do
		wedge(folder, "GateHaunch", Vector3.new(12, 8, 11), CFrame.new(gatePos + Vector3.new(side * 16, 21, 0)) * CFrame.Angles(0, side &gt; 0 and 0 or math.rad(180), 0), palette.Rock)
	end
	for bar = -3, 3 do
		cylinder(folder, "Portcullis", 0.8, 14, CFrame.new(gatePos + Vector3.new(bar * 5, 22, 0)), palette.Iron)
	end

	-- Houses and alleys.
	for _, side in { -1, 1 } do
		for index = 0, 4 do
			local z = HALF.Z - 62 - index * 34
			local jitter = (index % 2) * 4
			house(folder, CFrame.new(origin + Vector3.new(side * (30 + jitter), FLOOR_Y, z)) * CFrame.Angles(0, side &gt; 0 and math.pi or 0, 0),
				20 + (index % 3) * 3, 18, 13 + (index % 2) * 4, index % 3 == 0)
			if index % 2 == 0 then lamp(folder, origin + Vector3.new(side * 15, FLOOR_Y, z + 8)) end
		end
	end

	-- Market square: rune circle, well, stalls, drifting dust.
	local market = origin + Vector3.new(0, FLOOR_Y, 6)
	decor(folder, "Plaza", Vector3.new(76, 0.6, 62), CFrame.new(market + Vector3.new(0, 0.3, 0)), palette.Cobble)
	runeCircle(folder, market + Vector3.new(0, 0.6, 0), 34, palette.CrimsonLit)
	well(folder, market)
	shards(folder, market, 8, palette.CrimsonLit)
	dust(folder, market + Vector3.new(0, 10, 0), palette.Ember, 10, 1.1)
	for index = -1, 1 do
		marketStall(folder, CFrame.new(market + Vector3.new(index * 24, 0, -24)))
		props(folder, market + Vector3.new(index * 22, 0, 20), 4)
	end
	for side = -1, 1, 2 do
		brazier(folder, market + Vector3.new(side * 34, 0, 0), palette.Ember)
	end

	-- Chapel and forge.
	local chapel = origin + Vector3.new(-72, FLOOR_Y, -40)
	house(folder, CFrame.new(chapel), 26, 34, 22, false)
	roundTower(folder, chapel + Vector3.new(0, 0, -24), 11, 42, palette.Amber)
	for index = -1, 1, 2 do
		column(folder, chapel + Vector3.new(index * 15, 0, 19), 3, 14)
	end
	banner(folder, CFrame.new(chapel + Vector3.new(0, 20, 17.4)), 14)

	local forge = origin + Vector3.new(74, FLOOR_Y, -36)
	house(folder, CFrame.new(forge) * CFrame.Angles(0, math.rad(180), 0), 24, 20, 14, false)
	local coals = glow(folder, "ForgeCoals", Vector3.new(6, 0.8, 5), CFrame.new(forge + Vector3.new(0, 1.2, 13)), palette.CrimsonLit, 0.35)
	local forgeLight = Instance.new("PointLight")
	forgeLight.Color = Color3.fromRGB(255, 120, 60)
	forgeLight.Brightness = 2.2
	forgeLight.Range = 30
	forgeLight.Parent = coals
	props(folder, forge + Vector3.new(-12, 0, 12), 3)

	for index = -2, 2 do
		for side = -1, 1, 2 do
			lamp(folder, origin + Vector3.new(side * 14, FLOOR_Y, index * 36 - 20))
		end
		banner(folder, CFrame.new(origin + Vector3.new(index * 46, 16, -cz + 4.6)), 14)
		banner(folder, CFrame.new(origin + Vector3.new(-cx + 4.6, 16, index * 40)) * CFrame.Angles(0, math.rad(90), 0), 14)
	end

	dust(folder, origin + Vector3.new(0, 18, -60), palette.Indigo, 6, 1.4)
	signPost(folder, CFrame.new(origin + Vector3.new(-18, FLOOR_Y, cz - 26)), "OBJECTIVE", "Loading your charge...")
	signPost(folder, CFrame.new(market + Vector3.new(26, 0, 22)) * CFrame.Angles(0, math.rad(-35), 0), "OBJECTIVE", "Loading your charge...")

	return folder, cz
end

-- Zone 2: the keep ------------------------------------------------------------

local function buildKeep(zone, world)
	local folder = Instance.new("Folder")
	folder.Name = "BlackspireKeep"
	folder.Parent = world
	local origin = zone.Origin

	makePart(folder, "Bedrock", Vector3.new(HALF.X * 2 + 60, 14, HALF.Z * 2 + 60), CFrame.new(origin - Vector3.new(0, 7, 0)), palette.Bedrock)
	makePart(folder, "ArenaFloor", Vector3.new(HALF.X * 2, 3, HALF.Z * 2), CFrame.new(origin), zone.Floor)

	local cx, cz = HALF.X - 6, HALF.Z - 6
	local corners = {
		origin + Vector3.new(-cx, FLOOR_Y, -cz), origin + Vector3.new(cx, FLOOR_Y, -cz),
		origin + Vector3.new(cx, FLOOR_Y, cz), origin + Vector3.new(-cx, FLOOR_Y, cz),
	}
	for index = 1, 4 do
		local from, to = corners[index], corners[index % 4 + 1]
		if index == 3 then
			wallRun(folder, from, origin + Vector3.new(20, FLOOR_Y, cz), 30, 8)
			wallRun(folder, origin + Vector3.new(-20, FLOOR_Y, cz), to, 30, 8)
		else
			wallRun(folder, from, to, 30, 8)
		end
		roundTower(folder, from, 18, 44, palette.CrimsonLit)
	end

	cobbleRoad(folder, origin + Vector3.new(0, 0, cz - 10), origin + Vector3.new(0, 0, -40), 26)

	for side = -1, 1, 2 do
		for index = 0, 2 do
			house(folder, CFrame.new(origin + Vector3.new(side * 46, FLOOR_Y, 60 - index * 38)) * CFrame.Angles(0, side &gt; 0 and math.pi or 0, 0), 22, 26, 16, false)
		end
		lamp(folder, origin + Vector3.new(side * 18, FLOOR_Y, 40))
		lamp(folder, origin + Vector3.new(side * 18, FLOOR_Y, -4))
		for index = -1, 1 do
			banner(folder, CFrame.new(origin + Vector3.new(side * 34, 22, index * 38 + 20)), 18)
		end
	end

	-- The keep, raised on a plinth with a wedge-roofed hall and flanking towers.
	local keepPos = origin + Vector3.new(0, FLOOR_Y, -66)
	makePart(folder, "KeepPlinth", Vector3.new(120, 6, 76), CFrame.new(keepPos + Vector3.new(0, 3, 0)), palette.StoneDark)
	for step = 1, 5 do
		makePart(folder, "KeepStair", Vector3.new(44, 1.4, 4), CFrame.new(keepPos + Vector3.new(0, step * 1.2, 40 - step * 3.4)), palette.Stone)
	end
	for tier = 0, 2 do
		makePart(folder, "KeepHall", Vector3.new(84, 46 / 3, 52), CFrame.new(keepPos + Vector3.new(0, 6 + 46 / 6 + tier * (46 / 3), -8)),
			mix(palette.Obsidian, palette.Slate, 0.2 + tier * 0.28))
	end
	pitchedRoof(folder, CFrame.new(keepPos + Vector3.new(0, 52, -8)), 88, 56, 26, palette.Roof)
	for side = -1, 1, 2 do
		roundTower(folder, keepPos + Vector3.new(side * 50, 6, -8), 20, 56, palette.CrimsonLit)
		column(folder, keepPos + Vector3.new(side * 26, 6, 20), 4, 20)
	end
	local door = glow(folder, "KeepDoor", Vector3.new(16, 22, 1), CFrame.new(keepPos + Vector3.new(0, 17, 18.2)), palette.CrimsonLit, 0.6, Enum.Material.Glass)
	door.Reflectance = 0.2
	runeCircle(folder, keepPos + Vector3.new(0, 6.2, 26), 40, palette.Amber)
	shards(folder, keepPos + Vector3.new(0, 8, 10), 10, palette.Amber)
	dust(folder, keepPos + Vector3.new(0, 16, 6), palette.CrimsonLit, 12, 1.2)

	for side = -1, 1, 2 do
		brazier(folder, keepPos + Vector3.new(side * 32, 6, 26), palette.Amber)
		brazier(folder, origin + Vector3.new(side * 30, 0, -10), palette.Ember)
	end

	signPost(folder, CFrame.new(origin + Vector3.new(-24, FLOOR_Y, cz - 26)), "OBJECTIVE", "Loading your charge...")
	signPost(folder, CFrame.new(origin + Vector3.new(26, FLOOR_Y, -18)) * CFrame.Angles(0, math.rad(30), 0), "OBJECTIVE", "Loading your charge...")

	return folder, cz
end

-- Build ---------------------------------------------------------------------

function World.build()
	local existing = Workspace:FindFirstChild("SoulGrindWorld")
	if existing then existing:Destroy() end
	table.clear(signBoards)

	local world = Instance.new("Folder")
	world.Name = "SoulGrindWorld"
	world.Parent = Workspace

	World.applyLighting()

	local _, villageEdge = buildVillage(Config.Zones[1], world)
	buildKeep(Config.Zones[2], world)
	buildBackdrop(world, (Config.Zones[1].Origin + Config.Zones[2].Origin) / 2)

	local zoneOne, zoneTwo = Config.Zones[1], Config.Zones[2]
	local spawnPosition = zoneOne.Origin + Vector3.new(0, FLOOR_Y + 3, villageEdge - 30)

	local spawnPad = Instance.new("SpawnLocation")
	spawnPad.Name = "UnderworldSpawn"
	spawnPad.Size = Vector3.new(18, 1.2, 18)
	spawnPad.CFrame = CFrame.new(spawnPosition)
	spawnPad.Anchored = true
	spawnPad.Neutral = true
	spawnPad.Color = palette.Cobble
	spawnPad.Material = Enum.Material.SmoothPlastic
	spawnPad.Parent = world
	runeCircle(world, spawnPosition + Vector3.new(0, 0.7, 0), 22, palette.Amber)

	local function portal(position, accent, title, objectText, actionText, hold)
		local veil = makePart(world, "GateVeil", Vector3.new(30, 34, 1.4), CFrame.new(position + Vector3.new(0, 18, 0)), accent, Enum.Material.Neon)
		veil.Transparency = 0.8
		veil.CanCollide = false
		veil.CastShadow = false
		for side = -1, 1, 2 do
			roundTower(world, position + Vector3.new(side * 24, 0, 0), 16, 40, accent)
		end
		makePart(world, "GateLintel", Vector3.new(50, 10, 12), CFrame.new(position + Vector3.new(0, 38, 0)), palette.Rock)
		runeCircle(world, position + Vector3.new(0, FLOOR_Y, 10), 26, accent)
		shards(world, position + Vector3.new(0, 4, 0), 6, accent)
		addLabel(veil, title, palette.GoldPale, 22, 130)

		local light = Instance.new("PointLight")
		light.Color = accent
		light.Brightness = 2.2
		light.Range = 40
		light.Parent = veil

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = actionText
		prompt.ObjectText = objectText
		prompt.HoldDuration = hold
		prompt.MaxActivationDistance = 18
		prompt.RequiresLineOfSight = false
		prompt.Parent = veil
		return prompt
	end

	local gatePrompt = portal(zoneOne.Origin + Vector3.new(0, FLOOR_Y, -HALF.Z + 26), zoneOne.Accent,
		"THE ASH GATE", "Blackspire Keep", "Open the Ash Gate", 0.4)
	local returnPrompt = portal(zoneTwo.Origin + Vector3.new(0, FLOOR_Y, HALF.Z - 26), zoneTwo.Accent,
		"BACK TO ASHENFALL", "Ashenfall Village", "Return", 0.25)

	return {
		Folder = world,
		GatePrompt = gatePrompt,
		ReturnPrompt = returnPrompt,
		FloorY = FLOOR_Y,
	}
end

function World.posts(zoneId)
	local village = {
		Vector3.new(0, FLOOR_Y, 62), Vector3.new(-16, FLOOR_Y, 30), Vector3.new(18, FLOOR_Y, 34),
		Vector3.new(-30, FLOOR_Y, 6), Vector3.new(30, FLOOR_Y, 6), Vector3.new(0, FLOOR_Y, -24),
		Vector3.new(-56, FLOOR_Y, -44), Vector3.new(58, FLOOR_Y, -40), Vector3.new(0, FLOOR_Y, -66),
	}
	local keep = {
		Vector3.new(0, FLOOR_Y, 78), Vector3.new(-22, FLOOR_Y, 50), Vector3.new(22, FLOOR_Y, 48),
		Vector3.new(-24, FLOOR_Y, 10), Vector3.new(24, FLOOR_Y, 8), Vector3.new(0, FLOOR_Y, -14),
		Vector3.new(-30, FLOOR_Y, -34), Vector3.new(30, FLOOR_Y, -34), Vector3.new(0, FLOOR_Y, -44),
	}
	local list = zoneId == 2 and keep or village
	local origin = Config.Zones[zoneId].Origin
	local out = {}
	for index, offset in list do out[index] = origin + offset end
	return out
end

World.arrivalCFrame = function(zoneId)
	return CFrame.new(Config.Zones[zoneId].Origin + Vector3.new(0, FLOOR_Y + 6, HALF.Z - 30))
end

return World
</ProtectedString><string name="Name">World</string></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">local Model = {}

local ABILITY_KEYS = { "Strike", "Pulse", "Step" }

local function number(value, fallback, minimum)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.max(minimum or 0, math.floor(value))
end

local function utcDay(now)
	return math.floor(now / 86400)
end

function Model.new(now)
	local day = utcDay(now)
	return {
		Version = 1,
		Revision = 0,
		Souls = 0,
		Level = 1,
		Rebirths = 0,
		MaxZone = 1,
		Kills = 0,
		DeepKills = 0,
		Bosses = 0,
		ActiveDays = 1,
		Streak = 1,
		LastDay = day,
		DailyKills = 0,
		DailyClaimed = false,
		DailyActiveSeconds = 0,
		CheckInClaimed = false,
		SpendDays = 0,
		LastSpendDay = -1,
		Wallet = { Flares = 3 },
		Upgrades = { Strike = 0, Pulse = 0, Step = 0 },
		QuestsPaid = {},
		Collection = {},
		Receipts = {},
	}
end

function Model.normalize(raw, now)
	local base = Model.new(now)
	if type(raw) ~= "table" then
		return base
	end

	base.Revision = number(raw.Revision, 0)
	base.Souls = number(raw.Souls, 0)
	base.Level = number(raw.Level, 1, 1)
	base.Rebirths = number(raw.Rebirths, 0)
	base.MaxZone = math.clamp(number(raw.MaxZone, 1, 1), 1, 2)
	base.Kills = number(raw.Kills, 0)
	base.DeepKills = number(raw.DeepKills, 0)
	base.Bosses = number(raw.Bosses, 0)
	base.ActiveDays = number(raw.ActiveDays, 1, 1)
	base.Streak = number(raw.Streak, 1, 1)
	base.LastDay = number(raw.LastDay, utcDay(now))
	base.DailyKills = number(raw.DailyKills, 0)
	base.DailyClaimed = raw.DailyClaimed == true
	base.DailyActiveSeconds = number(raw.DailyActiveSeconds, 0)
	base.CheckInClaimed = raw.CheckInClaimed == true
	base.SpendDays = number(raw.SpendDays, 0)
	base.LastSpendDay = number(raw.LastSpendDay, -1, -1)
	base.Wallet.Flares = number(type(raw.Wallet) == "table" and raw.Wallet.Flares, 3)

	-- Move ranks are capped here as well as at purchase time, so a tampered or
	-- half-written save can never hand out a permanently overpowered ability.
	if type(raw.Upgrades) == "table" then
		for _, key in ABILITY_KEYS do
			base.Upgrades[key] = math.clamp(number(raw.Upgrades[key], 0), 0, 10)
		end
	end

	if type(raw.QuestsPaid) == "table" then
		for questId, paid in raw.QuestsPaid do
			if type(questId) == "string" and paid == true and #questId &lt;= 40 then
				base.QuestsPaid[questId] = true
			end
		end
	end
	if type(raw.Collection) == "table" then
		for key, value in raw.Collection do
			if type(key) == "string" and value == true and #key &lt;= 40 then
				base.Collection[key] = true
			end
		end
	end
	if type(raw.Receipts) == "table" then
		for purchaseId, productId in raw.Receipts do
			if type(purchaseId) == "string" and #purchaseId &lt;= 100 and type(productId) == "number" then
				base.Receipts[purchaseId] = productId
			end
		end
	end

	local day = utcDay(now)
	if day &gt; base.LastDay then
		base.ActiveDays += 1
		-- The ember chain never falls; missing a day does not erase progress.
		base.Streak += 1
		base.LastDay = day
		base.DailyKills = 0
		base.DailyClaimed = false
		base.DailyActiveSeconds = 0
		base.CheckInClaimed = false
	end
	Model.applyMilestones(base)

	return base
end

function Model.upgradeCost(profile)
	return math.floor(20 * (1.45 ^ (profile.Level - 1)))
end

function Model.rebirthCost(profile)
	return 500 + profile.Rebirths * 250
end

function Model.damage(profile)
	local base = (8 + profile.Level * 4) * (1 + profile.Rebirths * 0.1)
	return math.floor(base * Model.strikeMultiplier(profile))
end

-- Ability ranks ---------------------------------------------------------------
-- Kept as plain arithmetic so the CLI suite can check the curves without Roblox.

function Model.rank(profile, key)
	return (profile.Upgrades and profile.Upgrades[key]) or 0
end

function Model.abilityCost(baseCost, growth, rank)
	return math.floor(baseCost * (growth ^ rank))
end

function Model.strikeMultiplier(profile)
	return 1 + 0.14 * Model.rank(profile, "Strike")
end

function Model.strikeKnocksBack(profile)
	return Model.rank(profile, "Strike") &gt;= 3
end

function Model.pulseRange(profile, baseRange)
	return baseRange + 4 * Model.rank(profile, "Pulse")
end

function Model.pulseMultiplier(profile)
	return 1.4 * (1 + 0.12 * Model.rank(profile, "Pulse"))
end

function Model.dashCooldown(profile, baseCooldown)
	return math.max(1.2, baseCooldown - 0.4 * Model.rank(profile, "Step"))
end

function Model.dodgeWindow(profile)
	return 0.55 + 0.06 * Model.rank(profile, "Step")
end

function Model.applyMilestones(profile)
	if profile.Kills &gt;= 1 then profile.Collection.FirstSoul = true end
	if profile.Kills &gt;= 25 then profile.Collection.ShadeHunter = true end
	if profile.MaxZone &gt;= 2 then profile.Collection.Gatebreaker = true end
	if profile.Bosses &gt;= 1 then profile.Collection.WardenSigil = true end
	if profile.Rebirths &gt;= 1 then profile.Collection.Reborn = true end
	if profile.ActiveDays &gt;= 7 then profile.Collection.EmberVeteran = true end
	if profile.ActiveDays &gt;= 20 then profile.Collection.HollowCrown = true end
end

return Model
</ProtectedString><string name="Name">Model</string></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">local Receipt = {}

function Receipt.apply(profile, receipt, productCatalog, now)
	if type(profile) ~= "table" or type(receipt) ~= "table" then return false, "invalid" end
	if type(receipt.PurchaseId) ~= "string" or type(receipt.ProductId) ~= "number" then return false, "invalid" end
	local recorded = profile.Receipts[receipt.PurchaseId]
	if recorded then
		return recorded == receipt.ProductId, recorded == receipt.ProductId and "duplicate" or "mismatch"
	end
	local product = productCatalog[receipt.ProductId]
	if not product then return false, "unknown" end
	profile.Wallet[product.Item] = (profile.Wallet[product.Item] or 0) + product.Amount
	profile.Receipts[receipt.PurchaseId] = receipt.ProductId
	local day = math.floor((now or os.time()) / 86400)
	if profile.LastSpendDay ~= day then
		profile.LastSpendDay = day
		profile.SpendDays += 1
	end
	return true, "granted"
end

return Receipt
</ProtectedString><string name="Name">Receipt</string></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.SoulGrind.Config)
local Model = require(script.Parent.Model)

local volatile = RunService:IsStudio() and not Config.StudioPersistence
local dataStore = if volatile then nil else DataStoreService:GetDataStore(Config.DataStoreName)
local memory = {}
local cache = {}
local locks = {}

local Store = {}

local function key(userId)
	return `u_{userId}`
end

-- A plain flag beats a BindableEvent here: firing and destroying a BindableEvent in
-- the same resumption cycle can drop the queued :Wait() resumption under deferred
-- signal behaviour, which deadlocks every later write for that player.
local function acquire(userId)
	while locks[userId] do
		task.wait()
	end
	locks[userId] = true
end

local function release(userId)
	locks[userId] = nil
end

function Store.isDurable()
	return not volatile
end

function Store.load(userId)
	return Store.update(userId, function(profile)
		return profile
	end)
end

function Store.update(userId, transform)
	acquire(userId)
	local saved
	local ok, err = pcall(function()
		if volatile then
			local current = Model.normalize(memory[userId], os.time())
			saved = transform(current)
			if saved then
				saved = Model.normalize(saved, os.time())
				saved.Revision = current.Revision + 1
				memory[userId] = saved
			end
		else
			saved = assert(dataStore):UpdateAsync(key(userId), function(raw)
				local current = Model.normalize(raw, os.time())
				local nextProfile = transform(current)
				if not nextProfile then return nil end
				nextProfile = Model.normalize(nextProfile, os.time())
				nextProfile.Revision = current.Revision + 1
				return nextProfile
			end)
		end
	end)
	if ok and saved then cache[userId] = saved end
	release(userId)
	if not ok then warn(`Soul Grind data update failed for {userId}: {err}`) end
	return ok and saved ~= nil, saved
end

function Store.peek(userId)
	return cache[userId]
end

function Store.forget(userId)
	cache[userId] = nil
	if volatile then memory[userId] = nil end
end

return Store
</ProtectedString><string name="Name">Store</string></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.SoulGrind.Config)
local Receipt = require(script.Parent.Receipt)

local Commerce = {}
local Store
local publish
local notice
local applyAura

local productsById = {}
for _, product in Config.Products do
	if product.Id &gt; 0 then productsById[product.Id] = product end
end

Commerce.applyReceipt = Receipt.apply

local function processReceipt(receipt)
	if not Store.isDurable() then
		warn("Soul Grind refused a paid receipt because Studio persistence is disabled")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if type(receipt.PlayerId) ~= "number" or type(receipt.ProductId) ~= "number" or type(receipt.PurchaseId) ~= "string" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = productsById[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not product or not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local success, profile = Store.update(receipt.PlayerId, function(current)
		Receipt.apply(current, receipt, productsById)
		return current
	end)

	if not success or profile.Receipts[receipt.PurchaseId] ~= receipt.ProductId then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	publish(player)
	notice(player, `{product.Amount} Soul Flares entered your wallet.`)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function Commerce.refreshPass(player)
	local pass = Config.Passes.Aura
	local owns = false
	if pass.Id &gt; 0 then
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
		owns = ok and result == true
	end
	player:SetAttribute("HasAura", owns)
	applyAura(player, owns)
	publish(player)
end

function Commerce.offer(player, kind)
	if kind == "FlarePack" then
		local product = Config.Products.FlarePack
		if product.Id &lt;= 0 then
			notice(player, "Create the Soul Flare developer product, then set its ID in Config.")
			return
		end
		ReplicatedStorage.SoulGrind.Offer:FireClient(player, {
			kind = "Product", id = product.Id, label = product.Label, description = product.Description,
		})
	elseif kind == "Aura" then
		local pass = Config.Passes.Aura
		if pass.Id &lt;= 0 then
			notice(player, "Create the aura pass, then set its ID in Config.")
			return
		end
		ReplicatedStorage.SoulGrind.Offer:FireClient(player, {
			kind = "Pass", id = pass.Id, label = pass.Label, description = pass.Description,
		})
	end
end

function Commerce.init(storeModule, publishState, showNotice, auraFunction)
	Store, publish, notice, applyAura = storeModule, publishState, showNotice, auraFunction
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.Passes.Aura.Id then
			Commerce.refreshPass(player)
		end
	end)
end

Commerce.processReceiptForTest = processReceipt
return Commerce
</ProtectedString><string name="Name">Commerce</string></Properties></Item><Item class="Script" referent="RBX15"><Properties><bool name="Archivable">true</bool><bool name="Disabled">false</bool><ProtectedString name="Source">local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local root = ReplicatedStorage:WaitForChild("SoulGrind")
local Config = require(root.Config)
local Quests = require(root.Quests)
local Model = require(script.Parent.Model)
local Store = require(script.Parent.Store)
local Commerce = require(script.Parent.Commerce)
local World = require(script.Parent.World)

local Action = root:WaitForChild("Action")
local State = root:WaitForChild("State")
local Notice = root:WaitForChild("Notice")
local FX = root:WaitForChild("FX")

local palette = Config.Palette
local sessions = {}
local enemies = {}

local built = World.build()
local world = built.Folder

local function showNotice(player, message)
	Notice:FireClient(player, message)
end

local function updateLeaderstats(player, profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return end
	leaderstats.Souls.Value = profile.Souls
	leaderstats.Rebirths.Value = profile.Rebirths

	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local billboard = head and head:FindFirstChild("SoulRank")
	if billboard then
		local crown = profile.Collection.HollowCrown and "  |  HOLLOW CROWN" or ""
		billboard.Label.Text = `SOUL LV {profile.Level}  |  REBIRTH {profile.Rebirths}{crown}`
	end
end

local function abilityCosts(profile)
	local costs = {}
	for _, def in Config.Abilities do
		costs[def.Key] = Model.abilityCost(def.BaseCost, def.Growth, Model.rank(profile, def.Key))
	end
	return costs
end

-- The world signs and the HUD banner read the same active quest, so the answer to
-- "what am I supposed to do" is identical wherever the player looks.
local function publish(player)
	local profile = Store.peek(player.UserId)
	local session = sessions[player]
	if not profile or not session then return end
	updateLeaderstats(player, profile)

	local quests = Quests.snapshot(profile)
	local progress = {}
	for _, row in quests.Rows do progress[row.Id] = row.Value end

	if quests.Active then
		World.setObjective(quests.Active.Title:upper(), `{quests.Active.Detail}\n\n{quests.Active.Hint}`)
	else
		World.setObjective("ALL CHARGES BOUND", "Every quest is complete. Rebirth again or help a friend through the Ash Gate.")
	end

	State:FireClient(player, {
		Revision = profile.Revision,
		Souls = profile.Souls,
		Level = profile.Level,
		Rebirths = profile.Rebirths,
		MaxZone = profile.MaxZone,
		Kills = profile.Kills,
		DeepKills = profile.DeepKills,
		Bosses = profile.Bosses,
		ActiveDays = profile.ActiveDays,
		Streak = profile.Streak,
		Day = profile.LastDay,
		DailyKills = profile.DailyKills,
		DailyGoal = Config.DailyGoal,
		DailyClaimed = profile.DailyClaimed,
		CheckInClaimed = profile.CheckInClaimed,
		ActiveSeconds = profile.DailyActiveSeconds + session.UnsavedSeconds,
		FlareCount = profile.Wallet.Flares,
		HasAura = player:GetAttribute("HasAura") == true,
		AuraEnabled = session.AuraEnabled,
		FriendBonus = session.FriendBonus,
		Zone = session.Zone,
		UpgradeCost = Model.upgradeCost(profile),
		RebirthCost = Model.rebirthCost(profile),
		Damage = Model.damage(profile),
		PulseUnlocked = profile.Level &gt;= 3,
		Upgrades = profile.Upgrades,
		AbilityCosts = abilityCosts(profile),
		-- Only the numbers travel; titles and hints come from the shared Quests module.
		Quests = {
			Progress = progress,
			ActiveId = quests.Active and quests.Active.Id or nil,
			Completed = quests.Completed,
			Total = quests.Total,
			Rate = quests.Rate,
		},
		DailyName = "Bind 10 shades",
		DailyReward = Config.DailyReward,
		Collection = profile.Collection,
		Transient = not Store.isDurable(),
		SaveStatus = Store.isDurable() and "Saved" or "Studio preview: saving off",
	})
end

local function applyAura(player, enabled)
	local character = player.Character
	if not character then return end
	local old = character:FindFirstChild("SoulAura")
	if old then old:Destroy() end
	if not enabled then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "SoulAura"
	highlight.FillColor = palette.CrimsonLit
	highlight.FillTransparency = 0.6
	highlight.OutlineColor = palette.GoldLight
	highlight.OutlineTransparency = 0.15
	highlight.Parent = character
end

-- Quest rewards commit inside the same profile write that produced the progress, so a
-- reward can never be granted twice or granted without the progress that earned it.
local function settleQuests(profile, awarded)
	local snapshot = Quests.snapshot(profile)
	for _, row in snapshot.Rows do
		if row.Done and not profile.QuestsPaid[row.Id] then
			profile.QuestsPaid[row.Id] = true
			profile.Souls += row.Reward
			table.insert(awarded, row)
		end
	end
end

local function mutate(player, transform)
	local awarded = {}
	local success, profile = Store.update(player.UserId, function(current)
		-- UpdateAsync may run this more than once; never let an award list accumulate.
		table.clear(awarded)
		transform(current)
		Model.applyMilestones(current)
		settleQuests(current, awarded)
		return current
	end)
	if success then
		publish(player)
		for _, row in awarded do
			showNotice(player, `QUEST COMPLETE — {row.Title}   +{row.Reward} Souls`)
			FX:FireClient(player, { Kind = "Quest", Title = row.Title, Reward = row.Reward })
		end
	else
		showNotice(player, "The Underworld could not save that action. Try again.")
	end
	return success, profile
end

local function teleportToZone(player, zoneId)
	local profile = Store.peek(player.UserId)
	local session = sessions[player]
	if not profile or not session or zoneId &lt; 1 or zoneId &gt; profile.MaxZone then return false end
	session.Zone = zoneId
	local character = player.Character
	if character then character:PivotTo(World.arrivalCFrame(zoneId)) end
	publish(player)
	return true
end

local function unlockZone(player)
	local outcome
	local success = mutate(player, function(profile)
		if profile.MaxZone &gt;= 2 then
			outcome = "open"
			return
		end
		if profile.Souls &lt; 150 then
			outcome = "poor"
			return
		end
		profile.Souls -= 150
		profile.MaxZone = 2
		outcome = "unlocked"
	end)
	if not success then return end
	if outcome == "poor" then
		local profile = Store.peek(player.UserId)
		showNotice(player, `The Ash Gate needs 150 Souls. You hold {profile and profile.Souls or 0}.`)
	else
		if outcome == "unlocked" then showNotice(player, "The Ash Gate is open. The Molten Reliquary lies beyond.") end
		teleportToZone(player, 2)
	end
end

built.GatePrompt.Triggered:Connect(unlockZone)
built.ReturnPrompt.Triggered:Connect(function(player)
	teleportToZone(player, 1)
end)

-- Enemies -------------------------------------------------------------------
-- Bodies are mid-tone on purpose: not black silhouettes, not glowing. They read
-- against the lit floor by contrast and hue, and only the player's current target
-- gets an outline, drawn client-side.

local archetypes = {
	Shade = {
		Name = "CINDER SHADE", Health = 1, Damage = 1, Speed = 11, Reward = 1, Range = 5, Cooldown = 1.15,
		Body = Color3.fromRGB(142, 116, 116), Trim = Color3.fromRGB(217, 82, 74),
	},
	Reaver = {
		Name = "BONE REAVER", Health = 1.75, Damage = 1.35, Speed = 8, Reward = 1.65, Range = 6, Cooldown = 1.55,
		Body = Color3.fromRGB(156, 112, 78), Trim = Color3.fromRGB(224, 138, 60),
	},
	Wisp = {
		Name = "ASH WISP", Health = 0.7, Damage = 0.8, Speed = 14, Reward = 1.25, Range = 4.5, Cooldown = 0.9,
		Body = Color3.fromRGB(186, 168, 126), Trim = Color3.fromRGB(255, 233, 168),
	},
	Warden = {
		Name = "GILDED WARDEN", Health = 4.5, Damage = 1.55, Speed = 7, Reward = 5, Range = 7, Cooldown = 1.4,
		Body = Color3.fromRGB(170, 86, 74), Trim = Color3.fromRGB(201, 162, 74),
	},
}

local postOrder = { "Shade", "Shade", "Wisp", "Reaver", "Shade", "Wisp", "Reaver", "Reaver", "Shade" }

local function enemyPart(model, rootPart, name, size, offset, color, material, shape, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = rootPart.CFrame * offset
	part.Color = color
	part.Material = material or Enum.Material.Slate
	part.Shape = shape or Enum.PartType.Block
	part.Transparency = transparency or 0
	part.CanCollide = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = rootPart
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function addEnemyBar(rootPart, humanoid, title, color, height)
	local gui = Instance.new("BillboardGui")
	gui.Name = "EnemyBar"
	gui.Size = UDim2.fromOffset(190, 44)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 190
	gui.Parent = rootPart

	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.Size = UDim2.new(1, 0, 0, 22)
	label.BackgroundTransparency = 1
	label.Text = title
	label.TextColor3 = Color3.fromRGB(246, 236, 222)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(12, 6, 8)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.Parent = gui

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, -20, 0, 9)
	back.Position = UDim2.fromOffset(10, 27)
	back.BackgroundColor3 = Color3.fromRGB(18, 10, 12)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = back

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = corner:Clone()
	fillCorner.Parent = fill

	humanoid.HealthChanged:Connect(function(health)
		fill.Size = UDim2.fromScale(math.clamp(health / humanoid.MaxHealth, 0, 1), 1)
	end)
	return label
end

local function spawnEnemy(zoneId, postIndex)
	local zone = Config.Zones[zoneId]
	local boss = zoneId == 2 and postIndex == 9
	local kind = boss and "Warden" or postOrder[postIndex]
	local archetype = archetypes[kind]
	local home = World.posts(zoneId)[postIndex]

	local model = Instance.new("Model")
	model.Name = kind
	model:SetAttribute("Enemy", true)
	model:SetAttribute("Archetype", kind)
	model:SetAttribute("Zone", zoneId)
	model:SetAttribute("Boss", boss)
	model:SetAttribute("PostIndex", postIndex)
	model:SetAttribute("Home", home)
	model:SetAttribute("State", "Idle")
	model:SetAttribute("AttackDamage", math.floor(zone.EnemyDamage * archetype.Damage))
	model:SetAttribute("AttackRange", archetype.Range)
	model:SetAttribute("AttackCooldown", archetype.Cooldown)
	model:SetAttribute("SoulReward", math.floor(zone.SoulReward * archetype.Reward))

	local bodySize = boss and Vector3.new(5.4, 6.6, 4.4) or (kind == "Reaver" and Vector3.new(3.7, 4.8, 3.2) or Vector3.new(2.9, 4, 2.4))

	local rootPart = Instance.new("Part")
	rootPart.Name = "HumanoidRootPart"
	rootPart.Size = bodySize
	rootPart.Transparency = 1
	rootPart.CanCollide = true
	rootPart.TopSurface = Enum.SurfaceType.Smooth
	rootPart.BottomSurface = Enum.SurfaceType.Smooth
	rootPart.CFrame = CFrame.new(home + Vector3.new(0, bodySize.Y / 2, 0))
	rootPart.Parent = model

	local armor, trim = archetype.Body, archetype.Trim
	enemyPart(model, rootPart, "Torso", bodySize, CFrame.new(), armor, Enum.Material.Slate, kind == "Wisp" and Enum.PartType.Ball or Enum.PartType.Block)
	local headHeight = boss and 4.6 or (kind == "Reaver" and 3.4 or 2.9)
	enemyPart(model, rootPart, "Head", boss and Vector3.new(3.1, 3.1, 3.1) or Vector3.new(2, 2, 2), CFrame.new(0, headHeight, 0), armor, Enum.Material.Slate, Enum.PartType.Ball)
	-- Eyes and a small chest ember are the only bright pixels on an enemy.
	enemyPart(model, rootPart, "Eye", boss and Vector3.new(1.4, 0.4, 0.3) or Vector3.new(0.95, 0.26, 0.22), CFrame.new(0, headHeight + 0.15, -1), trim, Enum.Material.Neon)
	local core = enemyPart(model, rootPart, "SoulCore", boss and Vector3.new(1.5, 1.5, 0.4) or Vector3.new(0.85, 0.85, 0.3), CFrame.new(0, 0.2, -bodySize.Z / 2 - 0.15), trim, Enum.Material.Neon, Enum.PartType.Ball)
	enemyPart(model, rootPart, "Girdle", Vector3.new(bodySize.X + 0.3, 0.7, bodySize.Z + 0.3), CFrame.new(0, -bodySize.Y * 0.18, 0), palette.Iron, Enum.Material.Metal)

	if kind == "Wisp" then
		enemyPart(model, rootPart, "Tail", Vector3.new(1.4, 3.3, 1.4), CFrame.new(0, -2.6, 0) * CFrame.Angles(0, 0, math.rad(45)), armor, Enum.Material.Slate, Enum.PartType.Ball, 0.35)
	else
		for side = -1, 1, 2 do
			local armSize = boss and Vector3.new(1.6, 5.4, 1.6) or Vector3.new(1, kind == "Reaver" and 4.2 or 3.5, 1)
			enemyPart(model, rootPart, "Arm", armSize, CFrame.new(side * (bodySize.X / 2 + 0.7), 0, 0) * CFrame.Angles(0, 0, math.rad(side * -9)), armor, Enum.Material.Slate)
			if boss or kind == "Reaver" then
				enemyPart(model, rootPart, "Horn", Vector3.new(0.7, boss and 3.8 or 2.6, 0.7), CFrame.new(side * 1.2, headHeight + 1.7, 0) * CFrame.Angles(0, 0, math.rad(side * -24)), boss and palette.Gold or palette.Bone, Enum.Material.Metal)
			end
		end
	end

	local glow = Instance.new("PointLight")
	glow.Color = trim
	glow.Brightness = boss and 1.4 or 0.7
	glow.Range = boss and 16 or 9
	glow.Shadows = false
	glow.Parent = core

	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = math.floor(zone.EnemyHealth * archetype.Health)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = archetype.Speed
	humanoid.HipHeight = 0
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.DisplayName = archetype.Name
	humanoid.Parent = model
	model.PrimaryPart = rootPart
	model.Parent = world
	pcall(rootPart.SetNetworkOwner, rootPart, nil)

	local titleLabel = addEnemyBar(rootPart, humanoid, archetype.Name, trim, bodySize.Y / 2 + (boss and 5.5 or 3.6))
	model:SetAttribute("BaseSpeed", archetype.Speed)
	enemies[model] = { Title = titleLabel, Name = archetype.Name }

	humanoid.Died:Connect(function()
		enemies[model] = nil
		FX:FireAllClients({ Kind = "Death", Position = rootPart.Position, Color = trim, Boss = boss })
		local userId = model:GetAttribute("LastHitUserId")
		local player = type(userId) == "number" and Players:GetPlayerByUserId(userId) or nil
		if player and os.clock() - (model:GetAttribute("LastHitAt") or 0) &lt;= 12 then
			local friendMultiplier = sessions[player] and sessions[player].FriendBonus and 1.1 or 1
			local reward = math.floor((model:GetAttribute("SoulReward") or zone.SoulReward) * friendMultiplier)
			local granted = mutate(player, function(profile)
				profile.Souls += reward
				profile.Kills += 1
				profile.DailyKills += 1
				if zoneId == 2 then profile.DeepKills += 1 end
				if boss then profile.Bosses += 1 end
			end)
			if granted then showNotice(player, `+{reward} Souls{boss and "   •   The Warden falls." or ""}`) end
		end
		Debris:AddItem(model, 1.4)
		task.delay(boss and 14 or 6, function()
			if world.Parent then spawnEnemy(zoneId, postIndex) end
		end)
	end)
end

for zoneId in Config.Zones do
	for postIndex = 1, #postOrder do spawnEnemy(zoneId, postIndex) end
end

-- Combat --------------------------------------------------------------------

local function nearestEnemy(player, radius)
	local session = sessions[player]
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not session or not playerRoot then return nil end
	local best, bestDistance
	for model in enemies do
		local enemyRoot = model.PrimaryPart
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if enemyRoot and humanoid and humanoid.Health &gt; 0 and model:GetAttribute("Zone") == session.Zone then
			local distance = (enemyRoot.Position - playerRoot.Position).Magnitude
			if distance &lt;= radius and (not bestDistance or distance &lt; bestDistance) then
				best, bestDistance = model, distance
			end
		end
	end
	return best, bestDistance
end

-- Being hit wakes an enemy regardless of range, so a ranged opener cannot be used to
-- whittle something down from outside its aggro radius.
local function alert(enemy, player)
	if enemy:GetAttribute("State") ~= "Chasing" then
		enemy:SetAttribute("State", "Chasing")
		local entry = enemies[enemy]
		if entry then entry.Title.Text = `! {entry.Name}` end
	end
	enemy:SetAttribute("Target", player.UserId)
end

local function hitEnemy(player, enemy, damage, combo)
	local humanoid = enemy and enemy:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then return end
	enemy:SetAttribute("LastHitUserId", player.UserId)
	enemy:SetAttribute("LastHitAt", os.clock())
	alert(enemy, player)

	local flash = Instance.new("Highlight")
	flash.Name = "HitFlash"
	flash.FillColor = palette.GoldPale
	flash.FillTransparency = 0.25
	flash.OutlineColor = palette.GoldPale
	flash.OutlineTransparency = 0.3
	flash.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	flash.Parent = enemy
	Debris:AddItem(flash, 0.1)

	humanoid:TakeDamage(damage)
	FX:FireClient(player, { Kind = "Hit", Position = enemy.PrimaryPart.Position, Damage = damage, Combo = combo or 0 })
end

-- Every press of Soul Strike has to produce something the player can see. Silent early
-- returns are why the button felt dead: no swing, no sound, and no reason given.
local function attack(player)
	local session = sessions[player]
	local now = os.clock()
	if not session then return end

	local character = player.Character
	local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
	local body = character and character:FindFirstChildOfClass("Humanoid")
	if not characterRoot or not body or body.Health &lt;= 0 then
		showNotice(player, "Your body is still reforming.")
		return
	end

	local profile = Store.peek(player.UserId)
	if not profile then
		showNotice(player, "Your soul data is still loading. Try again in a moment.")
		return
	end
	if now &lt; session.NextAttack then
		FX:FireClient(player, { Kind = "Cooling", Ability = "Attack", Seconds = session.NextAttack - now })
		return
	end

	if now &gt; session.ComboExpires then session.Combo = 0 end
	session.Combo = session.Combo % 3 + 1
	session.ComboExpires = now + 0.95
	session.NextAttack = now + (session.Combo == 3 and Config.Cooldowns.Finisher or Config.Cooldowns.Attack)

	local enemy, distance = nearestEnemy(player, Config.AttackRange)
	FX:FireClient(player, { Kind = "Swing", Combo = session.Combo, Cooldown = session.NextAttack - now })
	if not enemy then
		session.Combo = 0
		local _, reach = nearestEnemy(player, math.huge)
		FX:FireClient(player, { Kind = "Miss", Distance = reach })
		return
	end

	local multiplier = ({ 1, 1.15, 1.7 })[session.Combo]
	hitEnemy(player, enemy, math.floor(Model.damage(profile) * multiplier), session.Combo)

	if session.Combo == 3 and enemy.PrimaryPart then
		local direction = enemy.PrimaryPart.Position - characterRoot.Position
		if direction.Magnitude &gt; 0 then enemy.PrimaryPart.AssemblyLinearVelocity += direction.Unit * 24 + Vector3.new(0, 8, 0) end
		-- Strike rank 3 turns the finisher into a small shockwave.
		if Model.strikeKnocksBack(profile) then
			for other in enemies do
				if other ~= enemy and other.PrimaryPart and other:GetAttribute("Zone") == session.Zone
					and (other.PrimaryPart.Position - characterRoot.Position).Magnitude &lt;= 16 then
					hitEnemy(player, other, math.floor(Model.damage(profile) * 0.6), 0)
				end
			end
		end
	end
	return distance
end

local function pulse(player)
	local session = sessions[player]
	local profile = Store.peek(player.UserId)
	if not session then return end
	if not profile then
		showNotice(player, "Your soul data is still loading. Try again in a moment.")
		return
	end
	if profile.Level &lt; 3 then
		showNotice(player, `Soul Pulse unlocks at Soul Level 3. You are Level {profile.Level} - upgrade in the Journal.`)
		return
	end
	if os.clock() &lt; session.NextPulse then
		showNotice(player, `Soul Pulse recharges in {math.ceil(session.NextPulse - os.clock())}s.`)
		return
	end
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not playerRoot then
		showNotice(player, "Your body is still reforming.")
		return
	end

	session.NextPulse = os.clock() + Config.Cooldowns.Pulse
	local radius = Model.pulseRange(profile, Config.PulseRange)
	local struck = 0
	for enemy in enemies do
		local humanoid = enemy:FindFirstChildOfClass("Humanoid")
		if enemy.PrimaryPart and humanoid and humanoid.Health &gt; 0 and enemy:GetAttribute("Zone") == session.Zone
			and (enemy.PrimaryPart.Position - playerRoot.Position).Magnitude &lt;= radius then
			hitEnemy(player, enemy, math.floor(Model.damage(profile) * Model.pulseMultiplier(profile)), 0)
			struck += 1
		end
	end
	FX:FireClient(player, { Kind = "Pulse", Position = playerRoot.Position, Hits = struck, Cooldown = Config.Cooldowns.Pulse, Radius = radius })
	showNotice(player, struck &gt; 0 and `Soul Pulse struck {struck}.` or "Soul Pulse found nothing in range.")

	local wave = World.makePart(world, "SoulPulse", Vector3.new(1, 1, 1), CFrame.new(playerRoot.Position), palette.CrimsonLit, Enum.Material.Neon)
	wave.Shape = Enum.PartType.Ball
	wave.CanCollide = false
	task.spawn(function()
		for size = 2, radius * 2, 4 do
			wave.Size = Vector3.new(size, size, size)
			wave.Transparency = 0.3 + size / (radius * 2.8)
			task.wait(0.025)
		end
		wave:Destroy()
	end)
end

local function dash(player)
	local session = sessions[player]
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local now = os.clock()
	if not session then return end
	if not playerRoot or not humanoid or humanoid.Health &lt;= 0 then
		showNotice(player, "Your body is still reforming.")
		return
	end
	if now &lt; session.NextDash then
		showNotice(player, `Soul Step recharges in {math.ceil(session.NextDash - now)}s.`)
		return
	end

	local profile = Store.peek(player.UserId)
	local cooldown = profile and Model.dashCooldown(profile, Config.Cooldowns.Dash) or Config.Cooldowns.Dash
	session.NextDash = now + cooldown
	session.DodgeUntil = now + (profile and Model.dodgeWindow(profile) or 0.55)
	session.Combo = 0
	playerRoot.AssemblyLinearVelocity = playerRoot.CFrame.LookVector * 74 + Vector3.new(0, 5, 0)
	FX:FireAllClients({ Kind = "Dash", Player = player, Cooldown = cooldown })
end

local function useFlare(player)
	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not playerRoot then
		showNotice(player, "Your soul must finish forming first.")
		return
	end
	local outcome
	local success = mutate(player, function(profile)
		if profile.Wallet.Flares &lt;= 0 then
			outcome = "empty"
			return
		end
		profile.Wallet.Flares -= 1
		outcome = "used"
	end)
	if not success then return end
	if outcome == "empty" then
		Commerce.offer(player, "FlarePack")
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(palette.GoldPale, palette.CrimsonLit)
	emitter.Lifetime = NumberRange.new(1.2, 2)
	emitter.Speed = NumberRange.new(12, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = playerRoot
	emitter:Emit(70)
	Debris:AddItem(emitter, 3)
end

local function refreshFriends()
	for _, session in sessions do session.FriendBonus = false end
	local currentPlayers = Players:GetPlayers()
	-- ponytail: quadratic only when players join/leave; cache friend pairs if server size grows.
	for i = 1, #currentPlayers do
		for j = i + 1, #currentPlayers do
			local a, b = currentPlayers[i], currentPlayers[j]
			if sessions[a] and sessions[b] then
				local ok, friends = pcall(a.IsFriendsWith, a, b.UserId)
				if ok and friends then sessions[a].FriendBonus = true; sessions[b].FriendBonus = true end
			end
		end
	end
	for player in sessions do publish(player) end
end

local allowedActions = {
	Sync = true, Attack = true, Pulse = true, Dash = true, Upgrade = true, UpgradeMove = true,
	UnlockZone = true, Travel = true, Rebirth = true, ClaimDaily = true, Flare = true, Aura = true,
}

Commerce.init(Store, publish, showNotice, applyAura)

local function upgradeMove(player, key)
	local def
	for _, entry in Config.Abilities do
		if entry.Key == key then def = entry end
	end
	if not def then return end

	local outcome, cost
	local success = mutate(player, function(profile)
		local rank = Model.rank(profile, def.Key)
		if profile.Level &lt; def.RequiresLevel then
			outcome = "locked"
			return
		end
		if rank &gt;= def.Max then
			outcome = "max"
			return
		end
		cost = Model.abilityCost(def.BaseCost, def.Growth, rank)
		if profile.Souls &lt; cost then
			outcome = "poor"
			return
		end
		profile.Souls -= cost
		profile.Upgrades[def.Key] = rank + 1
		outcome = "ranked"
	end)
	if not success then return end

	if outcome == "ranked" then
		local profile = Store.peek(player.UserId)
		showNotice(player, `{def.Name} is now rank {profile and Model.rank(profile, def.Key) or "?"}.`)
		FX:FireClient(player, { Kind = "Ranked", Ability = def.Key })
	elseif outcome == "max" then
		showNotice(player, `{def.Name} is already at its highest rank.`)
	elseif outcome == "locked" then
		showNotice(player, `{def.Name} needs Soul Level {def.RequiresLevel}.`)
	else
		showNotice(player, `{def.Name} rank up costs {cost or 0} Souls.`)
	end
end

Action.OnServerEvent:Connect(function(player, actionName, payload)
	local session = sessions[player]
	if not session or type(actionName) ~= "string" or not allowedActions[actionName] then return end
	if os.clock() &lt; session.NextRemote then return end
	session.NextRemote = os.clock() + 0.08
	session.LastAction = os.clock()

	if actionName == "Sync" then publish(player)
	elseif actionName == "Attack" then attack(player)
	elseif actionName == "Pulse" then pulse(player)
	elseif actionName == "Dash" then dash(player)
	elseif actionName == "UpgradeMove" then
		if type(payload) == "string" then upgradeMove(player, payload) end
	elseif actionName == "Upgrade" then
		local outcome, paid
		local success = mutate(player, function(profile)
			paid = Model.upgradeCost(profile)
			if profile.Souls &lt; paid then
				outcome = "poor"
				return
			end
			profile.Souls -= paid; profile.Level += 1; outcome = "upgraded"
		end)
		if success then showNotice(player, outcome == "upgraded" and "Soul power strengthened." or `You need {paid} Souls.`) end
	elseif actionName == "UnlockZone" then unlockZone(player)
	elseif actionName == "Travel" and (payload == 1 or payload == 2) then
		if not teleportToZone(player, payload) then showNotice(player, "That realm is still sealed.") end
	elseif actionName == "Rebirth" then
		local outcome, cost
		local success = mutate(player, function(profile)
			cost = Model.rebirthCost(profile)
			if profile.MaxZone &lt; 2 or profile.Souls &lt; cost then
				outcome = "blocked"
				return
			end
			profile.Souls = 0; profile.Level = 1; profile.Rebirths += 1; outcome = "reborn"
		end)
		if success then
			if outcome == "reborn" then teleportToZone(player, 1); showNotice(player, "Reborn: permanent damage increased by 10%.")
			else showNotice(player, `Open the Ash Gate and hold {cost} Souls to rebirth.`) end
		end
	elseif actionName == "ClaimDaily" then
		local outcome
		local success = mutate(player, function(profile)
			if profile.DailyClaimed then
				outcome = "claimed"
				return
			end
			if profile.DailyKills &lt; Config.DailyGoal then
				outcome = "incomplete"
				return
			end
			profile.DailyClaimed = true
			profile.Wallet.Flares += Config.DailyReward
			outcome = "rewarded"
		end)
		if success then
			local messages = { claimed = "Today's reward is already claimed.", incomplete = "Finish today's shade goal first.", rewarded = `Daily goal complete: +{Config.DailyReward} free Soul Flares.` }
			showNotice(player, messages[outcome])
		end
	elseif actionName == "Flare" then useFlare(player)
	elseif actionName == "Aura" then
		if player:GetAttribute("HasAura") then
			session.AuraEnabled = not session.AuraEnabled
			applyAura(player, session.AuraEnabled)
			publish(player)
		else Commerce.offer(player, "Aura") end
	end
end)

Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player
	for _, statName in { "Souls", "Rebirths" } do
		local stat = Instance.new("IntValue")
		stat.Name = statName
		stat.Parent = leaderstats
	end

	local success = Store.load(player.UserId)
	if not success then player:Kick("Your soul data could not be loaded safely. Please rejoin."); return end
	sessions[player] = {
		Zone = 1, NextAttack = 0, NextPulse = 0, NextDash = 0, NextRemote = 0,
		Combo = 0, ComboExpires = 0, DodgeUntil = 0,
		LastAction = os.clock(), UnsavedSeconds = 0, FriendBonus = false, AuraEnabled = true,
	}

	player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 8)
		if head then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "SoulRank"
			billboard.Size = UDim2.fromOffset(230, 34)
			billboard.StudsOffset = Vector3.new(0, 2.7, 0)
			billboard.AlwaysOnTop = true
			billboard.MaxDistance = 140
			billboard.Parent = head
			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextColor3 = palette.GoldLight
			label.TextStrokeTransparency = 0.2
			label.Font = Enum.Font.GothamBold
			label.TextScaled = true
			label.Parent = billboard
		end
		task.defer(function()
			teleportToZone(player, sessions[player] and sessions[player].Zone or 1)
			applyAura(player, player:GetAttribute("HasAura") == true and sessions[player] and sessions[player].AuraEnabled)
		end)
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
		if humanoid then
			humanoid.Died:Connect(function()
				local session = sessions[player]
				if session then session.Combo = 0; session.DodgeUntil = 0 end
				showNotice(player, "Your body fell. Your Souls and progress remain.")
			end)
		end
	end)

	Commerce.refreshPass(player)
	publish(player)
	showNotice(player, "Read the sign ahead, then strike the nearest shade.")
	refreshFriends()
end)

Players.PlayerRemoving:Connect(function(player)
	local session = sessions[player]
	if session and session.UnsavedSeconds &gt; 0 then
		local seconds = session.UnsavedSeconds
		Store.update(player.UserId, function(profile) profile.DailyActiveSeconds += seconds; return profile end)
	end
	sessions[player] = nil
	Store.forget(player.UserId)
	task.defer(refreshFriends)
end)

local function bossSlam(enemy)
	local enemyRoot = enemy.PrimaryPart
	if not enemyRoot or enemy:GetAttribute("SlamCharging") then return end
	enemy:SetAttribute("SlamCharging", true)
	enemy:SetAttribute("NextSlam", os.clock() + 7.5)
	local zoneId = enemy:GetAttribute("Zone")
	local zone = Config.Zones[zoneId]
	local center = Vector3.new(enemyRoot.Position.X, zone.Origin.Y + built.FloorY + 0.2, enemyRoot.Position.Z)

	local warning = World.makePart(world, "WardenWarning", Vector3.new(0.22, 2, 2), CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)), palette.CrimsonLit, Enum.Material.Neon)
	warning.Shape = Enum.PartType.Cylinder
	warning.Transparency = 0.5
	warning.CanCollide = false
	FX:FireAllClients({ Kind = "BossCharge", Position = center })

	TweenService:Create(warning, TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.22, 38, 38), Transparency = 0.22,
	}):Play()

	task.delay(1.15, function()
		if warning.Parent then warning:Destroy() end
		if not enemy.Parent or not enemy.PrimaryPart then return end
		FX:FireAllClients({ Kind = "BossSlam", Position = center })
		for player, session in sessions do
			local character = player.Character
			local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if session.Zone == zoneId and playerRoot and humanoid and humanoid.Health &gt; 0 and (playerRoot.Position - center).Magnitude &lt;= 19 then
				if os.clock() &lt;= session.DodgeUntil then
					FX:FireClient(player, { Kind = "Dodge" })
				else
					humanoid:TakeDamage(math.floor((enemy:GetAttribute("AttackDamage") or zone.EnemyDamage) * 1.7))
					FX:FireClient(player, { Kind = "Struck", Position = center })
				end
			end
		end
		enemy:SetAttribute("SlamCharging", false)
	end)
end

-- Enemy behaviour -----------------------------------------------------------
-- Three states. An enemy holds its post until you come inside Engage, chases while you
-- stay inside Leash, then walks home and heals. Nothing trails the player forever, and
-- nothing attacks from across the arena.

local function livingTargets()
	local targets = {}
	for player, session in sessions do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health &gt; 0 then
			table.insert(targets, { Player = player, Session = session, Root = root, Humanoid = humanoid })
		end
	end
	return targets
end

local STEP = 0.4

local function setState(enemy, state)
	if enemy:GetAttribute("State") == state then return end
	enemy:SetAttribute("State", state)
	local entry = enemies[enemy]
	if entry then
		entry.Title.Text = state == "Chasing" and `! {entry.Name}` or entry.Name
	end
end

local function stepEnemies()
	local targets = livingTargets()
	local aggro = Config.Aggro

	for enemy in enemies do
		local enemyRoot = enemy.PrimaryPart
		local humanoid = enemy:FindFirstChildOfClass("Humanoid")
		if not enemy.Parent or not enemyRoot or not humanoid or humanoid.Health &lt;= 0 then continue end

		local zoneId = enemy:GetAttribute("Zone")
		local home = enemy:GetAttribute("Home") or enemyRoot.Position
		local baseSpeed = enemy:GetAttribute("BaseSpeed") or 10
		local state = enemy:GetAttribute("State") or "Idle"
		local homeDistance = (enemyRoot.Position - home).Magnitude

		local nearest, nearestDistance
		for _, target in targets do
			if target.Session.Zone == zoneId then
				local distance = (target.Root.Position - enemyRoot.Position).Magnitude
				if not nearestDistance or distance &lt; nearestDistance then
					nearest, nearestDistance = target, distance
				end
			end
		end

		if state == "Chasing" then
			local lost = not nearest or nearestDistance &gt; aggro.Leash or homeDistance &gt; aggro.Leash
			if lost then setState(enemy, "Returning") end
		elseif nearest and nearestDistance &lt;= aggro.Engage and homeDistance &lt;= aggro.Leash then
			setState(enemy, "Chasing")
		end
		state = enemy:GetAttribute("State")

		if state == "Chasing" and nearest then
			humanoid.WalkSpeed = baseSpeed
			humanoid:MoveTo(nearest.Root.Position)

			if enemy:GetAttribute("Boss") and nearestDistance &lt; 34 and os.clock() &gt;= (enemy:GetAttribute("NextSlam") or 0) then
				bossSlam(enemy)
			end
			local attackRange = enemy:GetAttribute("AttackRange") or 5
			if nearestDistance &lt; attackRange and os.clock() &gt;= (enemy:GetAttribute("NextHit") or 0) then
				enemy:SetAttribute("NextHit", os.clock() + (enemy:GetAttribute("AttackCooldown") or 1.2))
				if os.clock() &lt;= nearest.Session.DodgeUntil then
					FX:FireClient(nearest.Player, { Kind = "Dodge" })
				else
					nearest.Humanoid:TakeDamage(enemy:GetAttribute("AttackDamage") or Config.Zones[zoneId].EnemyDamage)
					FX:FireClient(nearest.Player, { Kind = "Struck", Position = enemyRoot.Position })
				end
			end
		else
			-- Disengaged: walk home a little faster than it chased, and heal on the way.
			humanoid.WalkSpeed = baseSpeed * aggro.ReturnSpeed
			if homeDistance &gt; 4 then
				humanoid:MoveTo(home)
			elseif state == "Returning" then
				setState(enemy, "Idle")
			end
			if humanoid.Health &lt; humanoid.MaxHealth then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + aggro.RegenPerSecond * STEP)
			end
		end
	end
end

task.spawn(function()
	while task.wait(STEP) do
		local ok, err = pcall(stepEnemies)
		if not ok then warn(`Soul Grind enemy step failed: {err}`) end
	end
end)

local function stepSessions()
	for player, session in sessions do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health &gt; 0 and os.clock() - session.LastAction &lt; 90 then
			session.UnsavedSeconds += 1
		end

		if session.UnsavedSeconds &gt;= 60 then
			local seconds = session.UnsavedSeconds
			session.UnsavedSeconds = 0
			local saved = mutate(player, function(profile) profile.DailyActiveSeconds += seconds end)
			if not saved then session.UnsavedSeconds += seconds end
		end

		local profile = Store.peek(player.UserId)
		local totalActive = profile and profile.DailyActiveSeconds + session.UnsavedSeconds or 0
		if profile and not profile.CheckInClaimed and profile.DailyActiveSeconds &gt;= Config.CheckInSeconds and profile.DailyKills &gt;= Config.CheckInMinKills then
			local rewarded = false
			local saved = mutate(player, function(current)
				if not current.CheckInClaimed and current.DailyActiveSeconds &gt;= Config.CheckInSeconds and current.DailyKills &gt;= Config.CheckInMinKills then
					current.CheckInClaimed = true
					current.Wallet.Flares += 2
					rewarded = true
				end
			end)
			if saved and rewarded then showNotice(player, "Active check-in complete: +2 free Soul Flares.") end
		end
		if totalActive % 5 == 0 then publish(player) end
	end
end

task.spawn(function()
	while task.wait(1) do
		local ok, err = pcall(stepSessions)
		if not ok then warn(`Soul Grind session step failed: {err}`) end
	end
end)
